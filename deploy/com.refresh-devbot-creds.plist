<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.refresh-devbot-creds</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/xinjuan/refresh-devbot-creds.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>DEVBOT_SUDO_PASSWORD</key>
        <string>REPLACE_ME</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>WatchPaths</key>
    <array>
        <!-- Touched by the bot (running as the locked-down user) on auth failure
             to demand an immediate on-demand refresh. Must live in a world-
             writable location the bot can write AND this job (running as the
             Keychain-owning user) can stat — the bot's own home is 0700. -->
        <string>/Users/Shared/devbot-creds-refresh.trigger</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/xinjuan/refresh-devbot-creds.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xinjuan/refresh-devbot-creds.log</string>
</dict>
</plist>
